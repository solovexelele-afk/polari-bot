# Токен бота из Discord Developer Portal -> Bot -> Reset Token. Никому не показывайте.
DISCORD_TOKEN=
# ID сервера POLARI (ПКМ по серверу -> Копировать ID сервера). Команды синхронизируются мгновенно.
GUILD_ID=
DB_PATH=data/polari.db

MAX_OPEN_TICKETS=2
TICKET_COOLDOWN=60
WAITING_ROOMS=5
INTERVIEW_ROOMS=3
WARNS_TO_BAN=3
WARN_BAN_DAYS=30
MOD_ACTION_LIMIT=5
MOD_ACTION_WINDOW=600
REP_COOLDOWN_HOURS=12

FLOOD_MESSAGES=6
FLOOD_SECONDS=8
CAPS_MIN_LENGTH=12
CAPS_RATIO=0.75
MASS_MENTION_LIMIT=5
AUTOMOD_TIMEOUT_MINUTES=5

# --- Хостинг (Render) ---
# ID приватного канала для бэкапов базы. На бесплатном Render диск очищается при перезапуске,
# бот сохраняет БД в этот канал и восстанавливает её при старте.
BACKUP_CHANNEL_ID=
BACKUP_INTERVAL_MINUTES=30

# PORT и RENDER_EXTERNAL_URL Render задаёт сам (health-check и самопинг от засыпания).

# --- Сайт ---
# Developer Portal -> OAuth2 -> Client Secret. Redirect: <адрес сайта>/auth/callback
DISCORD_CLIENT_SECRET=
# Случайная длинная строка для подписи входа (на Render создаётся автоматически)
SESSION_SECRET=
# Ссылка-приглашение на Discord-сервер, IP сервера CS 2
DISCORD_INVITE=
CS2_SERVER_IP=
# Адрес сайта (на Render берётся автоматически)
SITE_URL=
